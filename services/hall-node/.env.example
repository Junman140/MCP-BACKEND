# Point every hall PC at the SAME central API ( Docker host LAN IP or DNS ), not 127.0.0.1.
API_URL=http://192.168.1.10:4000

# Register each hall as a Device in admin UI; use returned id + apiKey once.
DEVICE_ID=
DEVICE_SECRET=

# Central matching service URL (same Docker host), or run matching locally on the hall PC.
MATCHING_SERVICE_URL=http://192.168.1.10:5050

# Must match biometric-api TEMPLATE_ENCRYPTION_KEY exactly (64 hex chars).
TEMPLATE_ENCRYPTION_KEY=

# Local USB SDK bridge only — stays on this machine.
CAPTURE_BRIDGE_URL=http://127.0.0.1:8787

HALL_PORT=4100
HALL_DATA_DIR=./data
